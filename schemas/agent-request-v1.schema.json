{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meetingflow.local/schemas/agent-request-v1.schema.json",
  "title": "MeetingFlow Agent request v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "source"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {"const": "submit"},
        "source": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "operation", "job_id"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {"enum": ["status", "retry"]},
        "job_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  ]
}
